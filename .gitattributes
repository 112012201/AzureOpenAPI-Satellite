# Deployment target is Linux (nginx + PHP-FPM 8.4). Force LF in the repository so
# that a Windows working copy never rewrites files with CRLF — a stray CR in a
# PHP or shell file breaks the runtime (`bash: $'\r': command not found`,
# "headers already sent" style parse noise in PHP).
* text=auto eol=lf

# Binary assets must never be text-converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.gz binary
*.zip binary
*.tar binary

# Explicitly text + LF.
*.php text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# Keep Linguist from miscounting the vendored Swagger UI bundles.
swagger-ui-bundle.js linguist-vendored
swagger-ui-standalone-preset.js linguist-vendored
swagger-ui.css linguist-vendored
