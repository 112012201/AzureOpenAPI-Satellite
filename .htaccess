# =============================================================================
#  Apache fallback configuration.
#  The production deployment is nginx (see conf/nginx.conf.example); this file
#  keeps the site safe if it is ever served by Apache/LiteSpeed instead.
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve internals, data or logs.
    RewriteRule ^(lib|data|logs|conf|bin|tests)(/|$) - [F,L]

    # Serve existing files/directories directly, everything else to the API.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "\.(cache|lock|log|md|sh|ini|tar\.gz|sqlite|json\.tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files "router.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

# Static asset caching (PHP responses set their own Cache-Control headers).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType application/yaml "access plus 5 minutes"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/css application/json application/javascript application/yaml image/svg+xml
</IfModule>
