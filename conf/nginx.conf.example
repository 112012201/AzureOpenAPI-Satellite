# =============================================================================
#  AzureOpenAPI for Satellite - nginx site configuration (reference)
#
#  Target: BT Panel / aaPanel style deployment on /www/wwwroot/<site>, PHP-FPM
#  8.x, Tencent Cloud EdgeOne in front of the origin.
#
#  Replace:
#    <SITE_DOMAIN>   e.g. satellite.api.authskin.xyz
#    <SITE_ROOT>     e.g. /www/wwwroot/satellite.api.authskin.xyz
#    <PHP_SOCK>      e.g. unix:/tmp/php-cgi-82.sock
# =============================================================================

# ---- rate limit zones (protect the origin behind the CDN) -------------------
limit_req_zone $binary_remote_addr zone=satapi_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=satapi_heavy:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=satapi_conn:10m;

# gzip: the transmitters document is ~4 MB uncompressed
gzip on;
gzip_vary on;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/x-javascript
    application/xml
    application/yaml
    text/yaml
    image/svg+xml;

server {
    listen 80;
    listen 443 ssl http2;
    server_name <SITE_DOMAIN>;

    # ssl_certificate     /www/server/panel/vhost/cert/<SITE_DOMAIN>/fullchain.pem;
    # ssl_certificate_key /www/server/panel/vhost/cert/<SITE_DOMAIN>/privkey.pem;

    root <SITE_ROOT>;
    index index.html index.php;

    access_log /www/wwwlogs/<SITE_DOMAIN>.log;
    error_log  /www/wwwlogs/<SITE_DOMAIN>.error.log warn;

    charset utf-8;
    client_max_body_size 1m;
    limit_conn satapi_conn 40;

    # ---- baseline security headers -----------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # Enable once you are certain the site is HTTPS-only:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ---- never expose internals --------------------------------------------
    location ~ ^/(lib|data|logs|conf|bin|tests)/ {
        deny all;
        return 404;
    }

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    location = /.user.ini { deny all; return 404; }
    location ~* \.(cache|lock|sqlite|log|md|sh)$ { deny all; return 404; }
    location ~* ^/.*\.tar\.gz$ { deny all; return 404; }

    # ---- static assets: long lived, immutable ---------------------------------
    location = /openapi.yaml {
        default_type application/yaml;
        add_header Cache-Control "public, max-age=300, s-maxage=600" always;
        add_header Access-Control-Allow-Origin "*" always;
        try_files $uri =404;
    }

    location ~* ^/(assets|docs\.html|index\.html|oauth2-redirect\.html|favicon.*\.png|swagger-ui.*\.(css|js)|robots\.txt|site\.webmanifest)$ {
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }

    location ~* \.(css|js|png|svg|ico|webmanifest)$ {
        add_header Cache-Control "public, max-age=604800, immutable" always;
        try_files $uri =404;
    }

    # ---- API: TLE feeds (text or JSON) --------------------------------------
    location ~ ^/(v1/tle|v1/tle/|tle$|tle/) {
        limit_req zone=satapi_api burst=30 nodelay;
        include fastcgi_params;
        fastcgi_pass <PHP_SOCK>;
        fastcgi_param SCRIPT_FILENAME <SITE_ROOT>/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_read_timeout 60;
        fastcgi_buffers 16 32k;
        fastcgi_busy_buffers_size 64k;
    }

    # ---- API: heavy catalogue endpoints -------------------------------------
    location ~ ^/(v1/satellites|v1/transmitters|satnogs/) {
        limit_req zone=satapi_heavy burst=10 nodelay;
        include fastcgi_params;
        fastcgi_pass <PHP_SOCK>;
        fastcgi_param SCRIPT_FILENAME <SITE_ROOT>/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_read_timeout 90;
        fastcgi_buffers 32 64k;
        fastcgi_busy_buffers_size 128k;
    }

    # ---- API: everything else ------------------------------------------------
    location ~ ^/(v1|health|status|amsat/) {
        limit_req zone=satapi_api burst=20 nodelay;
        include fastcgi_params;
        fastcgi_pass <PHP_SOCK>;
        fastcgi_param SCRIPT_FILENAME <SITE_ROOT>/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_read_timeout 60;
    }

    # ---- legacy .php file names (kept for backward compatibility) ------------
    location ~ ^/[a-z_]+\.php$ {
        include fastcgi_params;
        fastcgi_pass <PHP_SOCK>;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 60;
    }

    location = /router.php { deny all; return 404; }

    # ---- static page + front controller fallback -----------------------------
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        return 404;
    }

    # ---- custom error pages --------------------------------------------------
    error_page 404 /404.html;
    error_page 500 502 503 504 /404.html;

    location = /404.html {
        internal;
        add_header Cache-Control "no-store" always;
    }
}
